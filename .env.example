# Copy to .env and fill in. All optional - the site works without them.

# Form endpoint (Formspree / Getform / your own API). If empty, forms open an email draft instead.
VITE_FORM_ENDPOINT=

# WhatsApp number in international format without + (client number is already the default)
VITE_WHATSAPP_NUMBER=918209541883

# Payment gateway key (e.g. Razorpay key id). Needs a backend to create orders. Leave empty until ready.
VITE_PAYMENT_KEY=

# Optional analytics id
VITE_GA_ID=

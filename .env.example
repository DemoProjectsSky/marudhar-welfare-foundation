# Copy to .env. All optional - the site works without them.

# Where forms are sent. With the bundled mail server (see /server) use: /api/enquiry
# (in production set the full URL, e.g. https://api.yourdomain.com/api/enquiry)
# If empty, forms open an email draft instead.
VITE_FORM_ENDPOINT=/api/enquiry

# WhatsApp number in international format without +
VITE_WHATSAPP_NUMBER=918209541883

# Payment gateway key (e.g. Razorpay key id). Needs a backend to create orders. Leave empty until ready.
VITE_PAYMENT_KEY=

# Optional analytics id
VITE_GA_ID=

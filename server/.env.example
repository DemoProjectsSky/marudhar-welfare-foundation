# Copy to server/.env and fill in. NEVER commit the real file and NEVER put these in the website (VITE_*) env.

# SMTP account that SENDS the mail (e.g. the foundation's Gmail with an App Password, or Zoho / Hostinger SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=marudharwelfarefoundation@gmail.com
SMTP_PASS=

# Where the enquiries are delivered
MAIL_TO=marudharwelfarefoundation@gmail.com
MAIL_FROM="Marudhar Welfare Foundation Website <marudharwelfarefoundation@gmail.com>"

# Website origin allowed to call this API (comma separated). Use * only for local testing.
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787
